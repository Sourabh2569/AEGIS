ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://aegis:aegis@postgres:5432/aegis
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aegis-local
JWT_SECRET=development-only-change-me
LOG_LEVEL=INFO

# --- Authentication (see docs/security/authentication.md) ---
# Real users: `make hash-password` generates a bcrypt entry to paste into a
# local, gitignored file (auth_users.local.json) referenced here, or into
# AUTH_USERS_JSON directly. Required outside development/test.
AUTH_USERS_FILE=
AUTH_USERS_JSON=
JWT_ACCESS_TOKEN_TTL_MINUTES=720
# SECURITY: only ever true in development/test. When true, a request with no
# valid Bearer token is trusted based on the plain X-AEGIS-Role header alone
# -- anyone can set that header to anything, so this must never be true where
# real users, real data, or real money are involved.
# validate_startup() enforces this; it's set true here purely for local dev
# convenience so existing tools/tests keep working without logging in.
AUTH_ALLOW_INSECURE_HEADER_FALLBACK=true
LIVE_EXECUTION_ENABLED=false
BROKER_ORDER_ACCESS=false
DATA_SOURCE_MODE=LIVE_READONLY
MARKET_DATA_ENABLED=true
# Set to "kite_connect" to activate the Zerodha Kite Connect adapter. See
# docs/data_activation_sprint/kite_connect_integration.md for setup steps.
MARKET_DATA_PROVIDER_NAME=
MARKET_DATA_PROVIDER_ENVIRONMENT=
MARKET_DATA_PROVIDER_BASE_URL=
MARKET_DATA_PROVIDER_CLIENT_ID=
# Kite Connect: your API secret (from the Kite developer console).
MARKET_DATA_PROVIDER_CLIENT_SECRET=
# Kite Connect: your API key (from the Kite developer console).
MARKET_DATA_PROVIDER_API_KEY=
# Kite Connect access tokens expire daily (~ every login session). This must be
# refreshed each trading day via the login flow described in
# docs/data_activation_sprint/kite_connect_integration.md -- it cannot be a
# static one-time secret.
MARKET_DATA_PROVIDER_ACCESS_TOKEN=
MARKET_DATA_PROVIDER_REDIRECT_URI=
MARKET_DATA_EOD_ENABLED=true
MARKET_DATA_QUOTES_ENABLED=false
MARKET_DATA_CORPORATE_ACTIONS_ENABLED=true
MARKET_DATA_CALENDAR_ENABLED=true
MARKET_DATA_BENCHMARK_ENABLED=true
LIVE_BROKER_CONNECTION_ENABLED=false
PAPER_TRADING_USE_LIVE_DATA=false
PAPER_TRADING_ENABLED=false
HUMAN_APPROVAL_REQUIRED=true
